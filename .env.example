DATABASE_URL=postgresql://user:password@host/database?sslmode=require
PAYLOAD_SECRET=your-secret-here
GOOGLE_VERTEX_API_KEY=your-google-vertex-api-key-here
GOOGLE_VERTEX_MODEL=gemini-2.5-flash
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Cloudinary (media storage)
CLOUDINARY_CLOUD_NAME=your-cloud-name
# Optional: same value as above if you need the name in browser bundles (see src/lib/media-url.ts)
# NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# Optional: restore Payload interactive migrate confirmation after dev schema push (default skips stdin).
# PAYLOAD_REQUIRE_DEV_PUSH_MIGRATION_CONFIRM=true
