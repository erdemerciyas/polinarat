{
  "name": "polinar",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "postinstall": "patch-package",
    "dev": "npx kill-port 3000 && next dev --port 3000",
    "build": "npm rebuild sharp && next build",
    "start": "npx kill-port 3000 && next start --port 3000",
    "lint": "next lint",
    "payload": "payload",
    "generate:types": "payload generate:types",
    "seed": "tsx seed/seed.ts",
    "i18n:import": "tsx scripts/import-i18n.ts",
    "i18n:export": "tsx scripts/export-i18n.ts",
    "i18n:validate": "tsx scripts/validate-i18n.ts",
    "i18n:scaffold": "tsx scripts/scaffold-i18n.ts",
    "i18n:scaffold-static": "tsx scripts/scaffold-static-i18n.ts",
    "i18n:create-page": "tsx scripts/create-static-page.ts",
    "i18n:normalize-locales": "tsx scripts/run-locale-migration.ts",
    "seed:de": "tsx scripts/import-i18n.ts --force && tsx scripts/seed-de-complete.ts && tsx scripts/seed-de-news.ts && tsx scripts/fix-homepage-hero.ts",
    "seed:about-images": "tsx scripts/seed-about-images.ts"
  },
  "dependencies": {
    "@google/genai": "^1.50.1",
    "@payloadcms/db-postgres": "^3.0.0",
    "@payloadcms/next": "^3.0.0",
    "@payloadcms/plugin-cloud-storage": "^3.0.0",
    "@payloadcms/plugin-seo": "^3.0.0",
    "@payloadcms/richtext-lexical": "^3.0.0",
    "@vercel/analytics": "^2.0.1",
    "cloudinary": "^2.9.0",
    "framer-motion": "^12.38.0",
    "geist": "^1.7.0",
    "graphql": "^16.9.0",
    "next": "15.3.9",
    "nodemailer": "^6.10.1",
    "payload": "^3.0.0",
    "payloadcms-storage-cloudinary": "^1.0.1",
    "pdf-lib": "^1.17.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sharp": "0.34.5"
  },
  "devDependencies": {
    "@tailwindcss/typography": "^0.5.19",
    "@types/node": "^22.0.0",
    "@types/nodemailer": "^6.4.17",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "autoprefixer": "^10.4.0",
    "dotenv": "^17.3.1",
    "eslint": "^9.0.0",
    "eslint-config-next": "^15.0.0",
    "kill-port": "^2.0.1",
    "patch-package": "^8.0.1",
    "postcss": "^8.4.0",
    "tailwindcss": "^3.4.0",
    "tsx": "^4.0.0",
    "typescript": "^5.6.0"
  },
  "overrides": {
    "payloadcms-storage-cloudinary": {
      "payload": "$payload",
      "@payloadcms/plugin-cloud-storage": "$@payloadcms/plugin-cloud-storage"
    }
  }
}
